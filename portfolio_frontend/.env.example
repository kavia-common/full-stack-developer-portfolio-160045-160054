# Example environment config for the portfolio frontend
# Leave REACT_APP_API_BASE_URL empty to use the built-in dev heuristic:
# - If the app runs on port 3000, it will call the backend on the same host at port 3001.
# - In production behind a reverse proxy, same-origin (relative) requests are used.
#
# Otherwise, explicitly set the backend base URL below.

# PUBLIC_INTERFACE
# REACT_APP_API_BASE_URL
# Description: Absolute base URL for the backend API.
# Example: https://your-backend.example.com
REACT_APP_API_BASE_URL=
